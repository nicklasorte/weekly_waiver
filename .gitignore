# Raw and processed data are reproducible from src/fetch.py + src/features.py.
# The manifest is the exception: it pins the exact nflverse revision the
# committed results were produced against, so it must be tracked.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/raw/MANIFEST.json

# Hand-maintained and personal, not a build artifact -- see roster.example.yaml.
data/roster.yaml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
