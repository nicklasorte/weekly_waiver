# Raw and processed data are reproducible from src/fetch.py + src/features.py.
# The manifest is the exception: it pins the exact nflverse revision the
# committed results were produced against, so it must be tracked.
#
# FETCH_LOG.json is the deliberate counterpart: fetch timestamps, which move on
# every run whether or not the bytes did. Tracking them made every weekly run a
# commit and so made the commit history a heartbeat instead of a record of
# change. Untracked here, useful on disk.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/raw/MANIFEST.json

# Hand-maintained and personal, not a build artifact -- see roster.example.yaml.
data/roster.yaml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store

# Replay model bundles: regenerated by the scripts in outputs/backtests/, and
# deliberately not committed next to the production bundles in models/. They are
# fitted on less data on purpose and must never be served.
outputs/backtests/replay_models/
outputs/backtests/replay_models_full/
